#!/usr/bin/make -f

%:
	dh $@ --buildsystem=meson

override_dh_auto_install:
	dh_testdir

	install -Dm755 obj-x86_64-linux-gnu/waywall/waywall $(CURDIR)/debian/waywall/usr/bin/waywall
	install -Dm644 README.md $(CURDIR)/debian/waywall/usr/share/doc/waywall/README.md
	install -Dm644 LICENSE $(CURDIR)/debian/waywall/usr/share/licenses/waywall/LICENSE
	cp -r doc $(CURDIR)/debian/waywall/usr/share/doc/waywall

	install -Dm644 /glfw/libglfw.so $(CURDIR)/debian/waywall/usr/local/lib64/waywall-glfw/libglfw.so
	install -Dm644 /glfw/libglfw.so.3 $(CURDIR)/debian/waywall/usr/local/lib64/waywall-glfw/libglfw.so.3
	install -Dm644 /glfw/libglfw.so.3.4 $(CURDIR)/debian/waywall/usr/local/lib64/waywall-glfw/libglfw.so.3.4
	install -Dm644 /glfw/CONTRIBUTORS.md $(CURDIR)/debian/waywall/usr/share/doc/waywall/glfw-CONTRIBUTORS.md
	install -Dm644 /glfw/LICENSE.md $(CURDIR)/debian/waywall/usr/share/doc/waywall/glfw-LICENSE.md
	install -Dm644 /glfw/PATCHES.md $(CURDIR)/debian/waywall/usr/share/doc/waywall/glfw-PATCHES.md

override_dh_usrlocal:
	:
